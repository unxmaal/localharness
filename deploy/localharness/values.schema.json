{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "pinned; `latest` makes every scheduled run a different program",
          "not": {
            "const": "latest"
          }
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "gpu": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "driver": {
          "enum": [
            "host",
            "operator"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sweep": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 9
        },
        "enabled": {
          "type": "boolean"
        },
        "suspend": {
          "type": "boolean"
        }
      }
    },
    "measure": {
      "type": "object",
      "properties": {
        "where": {
          "description": "where the work executes; the receipt carries it and comparable() refuses across it",
          "enum": [
            "in-pod",
            "gpu-node",
            "host"
          ]
        },
        "lane": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "description": "empty reads the winner from the receipts; a value pins one deliberately"
        }
      }
    },
    "judge": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gateway": {
          "type": "string"
        },
        "top": {
          "type": "integer",
          "minimum": 1
        },
        "controlRuns": {
          "type": "integer",
          "minimum": 1,
          "description": "one run is one draw from a sampling judge; the published verdict must not come from it"
        }
      }
    }
  }
}
